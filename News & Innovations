};


/* VARIABLES */

const newsGrid = document.getElementById("newsGrid");
const searchInput = document.getElementById("searchInput");
const sortSelect = document.getElementById("sortSelect");
const categoryButtons = document.querySelectorAll(".category-btn");
const loadMoreBtn = document.getElementById("loadMore");
const resultCount = document.getElementById("resultCount");

let selectedCategory = "All";
let visibleCount = 6;
let filteredArticles = [];

let savedArticles = JSON.parse(
    localStorage.getItem("vyomSavedArticles") || "[]"
);


/* IMAGE URL */

function getImage(image) {
    return `https://images.unsplash.com/${image}?auto=format&fit=crop&w=800&q=80`;
}


/* FILTER ARTICLES */

function filterArticles() {

    const search = searchInput.value.toLowerCase().trim();

    filteredArticles = articles.filter(article => {

        const matchesCategory =
            selectedCategory === "All" ||
            article.category === selectedCategory;

        const matchesSearch =
            article.title.toLowerCase().includes(search) ||
            article.description.toLowerCase().includes(search) ||
            article.category.toLowerCase().includes(search);

        const matchesSaved =
            selectedCategory !== "Saved" ||
            savedArticles.includes(article.id);

        return matchesCategory && matchesSearch && matchesSaved;

    });

    if (sortSelect.value === "latest") {
        filteredArticles.sort((a, b) =>
            new Date(b.date) - new Date(a.date)
        );
    }

    else if (sortSelect.value === "oldest") {
        filteredArticles.sort((a, b) =>
            new Date(a.date) - new Date(b.date)
        );
    }

    else if (sortSelect.value === "popular") {
        filteredArticles.sort((a, b) => b.views - a.views);
    }

    visibleCount = 6;

    renderArticles();
}


/* RENDER ARTICLES */

function renderArticles() {

    newsGrid.innerHTML = "";

    const visibleArticles = filteredArticles.slice(0, visibleCount);

    resultCount.textContent =
        `${filteredArticles.length} articles found`;

    if (visibleArticles.length === 0) {

        newsGrid.innerHTML = `
            <div class="empty-state">
                <h3>No Articles Found</h3>
                <p>Try another keyword or category.</p>
            </div>
        `;

        loadMoreBtn.style.display = "none";
        return;
    }

    visibleArticles.forEach(article => {

        const isSaved = savedArticles.includes(article.id);

        const card = document.createElement("article");
        card.className = "news-card";

        card.innerHTML = `

            <div class="card-image">

                <img
                src="${getImage(article.image)}"
                alt="${article.title}"
                loading="lazy">

                <span class="card-category">
                    ${article.category}
                </span>

            </div>

            <div class="card-content">

                <div class="card-date">
                    ${formatDate(article.date)}
                </div>

                <h3>${article.title}</h3>

                <p>${article.description}</p>

                <div class="card-footer">

                    <button class="card-read">
                        Read Article →
                    </button>

                    <button
                    class="bookmark ${isSaved ? "saved" : ""}"
                    aria-label="Save article"
                    title="Save article">
                        ${isSaved ? "♥" : "♡"}
                    </button>

                </div>

            </div>
        `;

        card.querySelector(".card-read").addEventListener(
            "click",
            () => openArticle(article.id)
        );

        card.querySelector(".bookmark").addEventListener(
            "click",
            () => toggleBookmark(article.id)
        );

        newsGrid.appendChild(card);

    });

    loadMoreBtn.style.display =
        visibleCount < filteredArticles.length ? "inline-block" : "none";

}


/* FORMAT DATE */

function formatDate(date) {

    return new Date(date + "T00:00:00").toLocaleDateString(
        "en-IN",
        {
            day: "numeric",
            month: "long",
            year: "numeric"
        }
    );

}


/* CATEGORY FILTER */

categoryButtons.forEach(button => {

    button.addEventListener("click", () => {

        categoryButtons.forEach(btn =>
            btn.classList.remove("active")
        );

        button.classList.add("active");

        selectedCategory = button.dataset.category;

        filterArticles();

    });

});


/* SEARCH */

searchInput.addEventListener("input", filterArticles);


/* SORT */

sortSelect.addEventListener("change", filterArticles);


/* LOAD MORE */

loadMoreBtn.addEventListener("click", () => {

    visibleCount += 3;

    renderArticles();

});


/* BOOKMARK SYSTEM */

function toggleBookmark(id) {

    if (savedArticles.includes(id)) {

        savedArticles = savedArticles.filter(item => item !== id);

    } else {

        savedArticles.push(id);

    }

    localStorage.setItem(
        "vyomSavedArticles",
        JSON.stringify(savedArticles)
    );

    renderArticles();

}


/* OPEN ARTICLE */

function openArticle(id) {

    const article = articles.find(item => item.id === id);

    if (!article) return;

    showModal(article);

}


/* OPEN FEATURED */

function openFeatured() {

    showModal(featuredArticle);

}


/* MODAL */

function showModal(article) {

    const modal = document.getElementById("articleModal");
    const modalContent = document.getElementById("modalContent");

    modalContent.innerHTML = `

        <span class="tag">${article.category}</span>

        <h2>${article.title}</h2>

        <div class="article-meta">
            VyomShikhar Editorial • ${formatDate(article.date)}
        </div>

        <img
        src="${getImage(article.image)}"
        alt="${article.title}">

        <p>${article.description}</p>

        <p>${article.content}</p>

        <p>
            <strong>VyomShikhar Perspective:</strong>
            Knowledge grows when we remain curious,
            examine ideas and continue learning.
        </p>

    `;

    modal.classList.add("show");
    document.body.style.overflow = "hidden";

}


function closeModal() {

    document.getElementById("articleModal").classList.remove("show");

    document.body.style.overflow = "";

}


document.getElementById("articleModal").addEventListener(
    "click",
    function(event) {

        if (event.target === this) {
            closeModal();
        }

    }
);


document.addEventListener("keydown", function(event) {

    if (event.key === "Escape") {
        closeModal();
    }

});


/* NEWSLETTER DEMO */

document.getElementById("newsletterForm").addEventListener(
    "submit",
    function(event) {

        event.preventDefault();

        const email = document.getElementById("emailInput").value;

        document.getElementById("subscribeMessage").textContent =
            "Thank you for your interest! Newsletter backend is not connected yet.";

        this.reset();

    }
);


/* INITIALIZE */

filterArticles();

</script>

