<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --green: #176b50;
    --dark: #183c32;
    --light: #f5f8f5;
    --text: #24352f;
    --muted: #718078;
    --border: #e7ede8;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: #ffffff;
    color: var(--text);
    line-height: 1.7;
}

button, input {
    font: inherit;
}

/* HEADER */

.news-header {
    background: #f5f8f5;
    padding: 75px 6% 65px;
    position: relative;
    overflow: hidden;
}

.news-header::after {
    content: "";
    position: absolute;
    width: 350px;
    height: 350px;
    border: 65px solid rgba(23,107,80,.06);
    border-radius: 50%;
    right: -100px;
    top: -150px;
}

.header-inner {
    max-width: 1250px;
    margin: auto;
    position: relative;
    z-index: 1;
}

.eyebrow {
    color: var(--green);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 15px;
}

.news-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(38px, 6vw, 70px);
    line-height: 1.15;
    color: var(--dark);
    max-width: 800px;
}

.news-header h1 span {
    color: var(--green);
}

.header-description {
    max-width: 680px;
    color: #63736a;
    font-size: 17px;
    margin-top: 20px;
}

.header-meta {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    margin-top: 27px;
    font-size: 13px;
    color: var(--muted);
}

/* MAIN CONTAINER */

.main-container {
    max-width: 1320px;
    width: 90%;
    margin: 65px auto;
}

/* SECTION HEADING */

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 25px;
}

.section-heading h2 {
    font-family: 'Playfair Display', serif;
    color: var(--dark);
    font-size: clamp(26px, 4vw, 36px);
}

.section-heading p {
    color: var(--muted);
    font-size: 14px;
}

/* FEATURED ARTICLE */

.featured {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--light);
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 75px;
    min-height: 380px;
}

.featured-image {
    min-height: 380px;
    overflow: hidden;
}

.featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .6s;
}

.featured:hover .featured-image img {
    transform: scale(1.04);
}

.featured-content {
    padding: clamp(25px, 5vw, 55px);
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.tag {
    display: inline-block;
    width: fit-content;
    background: #e1eee5;
    color: var(--green);
    padding: 5px 13px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .7px;
    text-transform: uppercase;
}

.featured-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(25px, 3vw, 37px);
    line-height: 1.3;
    color: var(--dark);
    margin: 18px 0;
}

.featured-content p {
    color: var(--muted);
    font-size: 15px;
}

.article-meta {
    color: #87948c;
    font-size: 12px;
    margin: 15px 0;
}

.read-btn {
    width: fit-content;
    border: none;
    background: var(--green);
    color: white;
    padding: 12px 23px;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 12px;
    font-weight: 700;
    transition: .3s;
}

.read-btn:hover {
    background: var(--dark);
    transform: translateY(-3px);
}

/* CATEGORY NAVIGATION */

.category-area {
    margin-bottom: 35px;
}

.category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.category-btn {
    border: 1px solid var(--border);
    background: white;
    color: #52635a;
    padding: 10px 19px;
    border-radius: 30px;
    cursor: pointer;
    font-size: 13px;
    transition: .3s;
}

.category-btn:hover,
.category-btn.active {
    background: var(--green);
    color: white;
    border-color: var(--green);
}

/* SEARCH AND SORT */

.toolbar {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
    margin: 30px 0;
}

.search-box {
    flex: 1;
    min-width: 220px;
    position: relative;
}

.search-box input {
    width: 100%;
    border: 1px solid var(--border);
    padding: 13px 17px;
    border-radius: 7px;
    outline: none;
    background: #fafcfb;
}

.search-box input:focus {
    border-color: var(--green);
}

.sort-select {
    border: 1px solid var(--border);
    padding: 12px 15px;
    border-radius: 7px;
    outline: none;
    background: white;
    color: var(--text);
    cursor: pointer;
}

/* ARTICLE GRID */

.news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 27px;
}

.news-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: .35s;
    animation: appear .5s ease both;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(18px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.news-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 12px 35px rgba(20,65,45,.10);
}

.card-image {
    height: 220px;
    overflow: hidden;
    position: relative;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .5s;
}

.news-card:hover .card-image img {
    transform: scale(1.07);
}

.card-category {
    position: absolute;
    top: 14px;
    left: 14px;
    background: white;
    color: var(--green);
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
}

.card-content {
    padding: 22px;
}

.card-date {
    color: #89958d;
    font-size: 11px;
}

.card-content h3 {
    font-family: 'Playfair Display', serif;
    font-size: 21px;
    line-height: 1.4;
    margin: 10px 0;
    color: var(--dark);
}

.card-content p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.8;
}

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    margin-top: 18px;
    padding-top: 15px;
}

.card-read {
    color: var(--green);
    font-size: 13px;
    font-weight: 800;
    background: none;
    border: none;
    cursor: pointer;
}

.bookmark {
    border: none;
    background: #f0f5f1;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--green);
    font-size: 18px;
}

.bookmark.saved {
    background: var(--green);
    color: white;
}

/* EMPTY MESSAGE */

.empty-state {
    text-align: center;
    padding: 65px 15px;
    color: var(--muted);
    grid-column: 1 / -1;
}

.empty-state h3 {
    color: var(--dark);
    font-family: 'Playfair Display', serif;
    font-size: 27px;
}

/* LOAD MORE */

.load-area {
    text-align: center;
    margin: 45px 0 80px;
}

.load-btn {
    background: white;
    border: 1px solid var(--green);
    color: var(--green);
    padding: 13px 35px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 700;
    transition: .3s;
}

.load-btn:hover {
    background: var(--green);
    color: white;
}

/* QUOTE SECTION */

.quote-section {
    background: #edf4ee;
    padding: 55px 25px;
    border-radius: 15px;
    text-align: center;
    margin-bottom: 70px;
}

.quote-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(23px, 4vw, 35px);
    color: var(--dark);
    max-width: 800px;
    margin: auto;
    line-height: 1.5;
}

.quote-section p {
    margin-top: 15px;
    color: var(--green);
    font-size: 13px;
}

/* NEWSLETTER */

.newsletter {
    background: var(--dark);
    color: white;
    padding: 50px 25px;
    text-align: center;
    border-radius: 15px;
    margin-bottom: 65px;
}

.newsletter h2 {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
}

.newsletter p {
    color: #d1dfd6;
    margin: 10px auto 22px;
    max-width: 550px;
    font-size: 14px;
}

.newsletter-form {
    display: flex;
    max-width: 500px;
    margin: auto;
    gap: 8px;
}

.newsletter-form input {
    flex: 1;
    min-width: 0;
    padding: 13px;
    border: none;
    border-radius: 5px;
    outline: none;
}

.newsletter-form button {
    border: none;
    background: #b9d9c2;
    color: var(--dark);
    font-weight: 800;
    padding: 0 20px;
    border-radius: 5px;
    cursor: pointer;
}

/* FOOTER */

.news-footer {
    background: #f5f8f5;
    text-align: center;
    padding: 30px 15px;
    color: var(--muted);
    font-size: 13px;
}

/* ARTICLE POPUP */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal.show {
    display: flex;
}

.modal-box {
    width: 100%;
    max-width: 750px;
    max-height: 90vh;
    overflow-y: auto;
    background: white;
    border-radius: 12px;
    padding: 30px;
    position: relative;
}

.modal-box img {
    width: 100%;
    max-height: 330px;
    object-fit: cover;
    border-radius: 8px;
    margin: 20px 0;
}

.modal-box h2 {
    font-family: 'Playfair Display', serif;
    font-size: 30px;
    line-height: 1.3;
    color: var(--dark);
    margin-top: 15px;
}

.modal-box p {
    color: #56665e;
    margin: 15px 0;
    line-height: 1.9;
}

.close-modal {
    position: sticky;
    float: right;
    top: 0;
    border: none;
    background: var(--green);
    color: white;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 20px;
}

/* RESPONSIVE DESIGN */

@media(max-width: 1000px) {
    .news-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured {
        grid-template-columns: 1fr 1fr;
    }
}

@media(max-width: 650px) {
    .news-header {
        padding: 55px 6%;
    }

    .main-container {
        width: 92%;
        margin-top: 40px;
    }

    .featured {
        grid-template-columns: 1fr;
    }

    .featured-image {
        min-height: 240px;
        height: 240px;
    }

    .featured-content {
        padding: 25px;
    }

    .news-grid {
        grid-template-columns: 1fr;
        gap: 22px;
    }

    .card-image {
        height: 230px;
    }

    .section-heading {
        align-items: start;
        flex-direction: column;
    }

    .newsletter-form {
        flex-direction: column;
    }

    .newsletter-form button {
        padding: 13px;
    }

    .modal-box {
        padding: 20px;
    }

    .modal-box h2 {
        font-size: 24px;
    }
}

@media(prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }
}
</style>
</head>

